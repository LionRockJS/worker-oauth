{
  "name": "worker-oauth",
  "version": "0.1.0",
  "description": "Private OAuth 2.1 provider for Cloudflare Workers",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./public/styles.css --minify",
    "dev": "npm run build:css && wrangler dev",
    "deploy": "npm run build:css && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply worker-oauth-db --local",
    "db:migrate": "wrangler d1 migrations apply worker-oauth-db --remote",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.2",
    "wrangler": "^3.60.3"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.7.0",
    "argon2id": "^1.0.1"
  }
}
