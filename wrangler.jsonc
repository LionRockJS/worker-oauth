{
  // Cloudflare Worker – Private OAuth 2.1 Provider
  "name": "worker-oauth",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // Static HTML / CSS / JS assets (public/ directory)
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // Public configuration variables
  "vars": {
    // The canonical issuer URL of this authorization server
    "ISSUER": "https://your-worker.workers.dev",
    // Access token lifetime in seconds
    "TOKEN_EXPIRY": "3600",
    // Refresh token lifetime in seconds
    "REFRESH_TOKEN_EXPIRY": "2592000"
  }

  // Secrets (set via `wrangler secret put`):
  //   JWT_PRIVATE_KEY  – base64-encoded JSON Web Key (RSA private, for RS256)
  //   JWT_PUBLIC_KEY   – base64-encoded JSON Web Key (RSA public)
  //   JWT_KID          – key ID string matching the JWK
  //
  // If these secrets are absent the worker auto-generates a key pair on first
  // start and stores it in the SESSIONS KV namespace (handy for local dev).
}
