{
	// Cloudflare Worker – Private OAuth 2.1 Provider
	"name": "worker-oauth",
	"main": "src/index.ts",
	"compatibility_date": "2024-11-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Static HTML / CSS / JS assets (public/ directory)
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		// Always invoke the Worker first so template routes (/login, /register,
		// /dashboard) are processed before static files are served.
		"run_worker_first": true
	},
	// D1 SQLite database – users, clients, tokens, etc.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "worker-oauth-db",
			"database_id": "9442bcc0-461f-4c62-acd0-c3683a72fd46",
			"migrations_dir": "migrations"
		}
	],
	// KV namespaces
	"kv_namespaces": [
		{
			"binding": "SESSIONS",
			"id": "85d02a83b4c74805a39a2cf625b0b63b"
		},
		{
			"binding": "OAUTH_KV",
			"id": "1cb29c82bc4f44a89873d5eba1ac98a0"
		}
	],
	// Durable Objects – atomic login rate-limit counters
	"durable_objects": {
		"bindings": [
			{
				"name": "RATE_LIMITER",
				"class_name": "RateLimiter"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"RateLimiter"
			]
		}
	],
	// Public configuration variables
	"vars": {
		// The canonical issuer URL of this authorization server
		"ISSUER": "https://id.eventuai.com",
		// Public reCAPTCHA Enterprise site key used by /login
		"RECAPTCHA_SITE_KEY": "6LfhfwQtAAAAACRmsenmnvRlj6eNikByvdpDi_8J",
		// Set this to the Google Cloud project ID that owns the site key before deploy.
		// "RECAPTCHA_PROJECT_ID": "your-google-cloud-project-id",
		"RECAPTCHA_MIN_SCORE": "0.5",
		// reCAPTCHA is enforced (fail-closed) by default. Set to "false" only for
		// local dev without reCAPTCHA credentials; never in production.
		"RECAPTCHA_ENFORCE": "true"
	}
}
